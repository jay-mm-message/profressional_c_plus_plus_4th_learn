
# ==================================================
# C++ Build Artifacts
# C++ 編譯產生的執行檔與中間檔
# ==================================================

# Executable files
app
main
a.out

# Object files
*.o
*.obj

# Debug symbols generated by macOS
*.dSYM/

# Libraries
*.a
*.dylib
*.so

# ==================================================
# VS Code
# 保留團隊共用的 Build / Debug 設定
# ==================================================

# Ignore personal workspace settings
.vscode/settings.json

# Ignore VS Code temporary files
.vscode/*.log

# Ignore VS Code launch configurations for personal debugging
# 不要加入以下規則，因為我們要保留 launch.json
# .vscode/launch.json

# 不要忽略 tasks.json
# .vscode/tasks.json

# ==================================================
# macOS
# ==================================================

.DS_Store
.AppleDouble
.LSOverride

# ==================================================
# Temporary files
# ==================================================

*.tmp
*.swp
*~

# ==================================================
# Editor / IDE
# ==================================================

.idea/
*.code-workspace
